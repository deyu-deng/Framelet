# =============================================================================
# MiniMax Open Platform credentials (DO NOT COMMIT real values)
# =============================================================================
# Copy this file to `.env` and fill in your real credentials.
# `.env` is excluded by .gitignore — your secrets will never enter git.

# 1. Get API_KEY from: https://platform.minimax.io → API Keys → Create New Secret Key
#    ⚠️ Must be the Open Platform API Key, NOT the Token Plan Key
#       (Token Plan Key only works for T2A; cloning fails with "insufficient balance")
MINIMAX_API_KEY=eyJhbGciOiJSUzI1NiIsInR5cCI6...

# 2. Get GroupId from: https://platform.minimax.io → Account → Your Profile
MINIMAX_GROUP_ID=1234567890

# 3. After running `python GenerateAudio.py --clone` for the first time, paste
#    the returned voice_id here. Then re-run without `--clone` to skip cloning.
#    Rules: 8-256 chars, must start with a letter, letters/digits/-/_ only,
#           cannot end with - or _.
MINIMAX_VOICE_ID=plobi_voice_v1

# 4. Path to your recorded voice sample (use the script in Docs/EP001_VoiceSampleScript.md)
VOICE_SAMPLE_PATH=Episodes/EP001_SelfIntro/Audio/my_voice_sample.wav

# 5. Output model. speech-2.8-hd supports emotion & sound tags (recommended).
#    Other options: speech-2.8-turbo (faster), speech-02-hd, speech-02-turbo
MINIMAX_TTS_MODEL=speech-2.8-hd
